        "\n",
        "The preprocessing function was:\n",
        "\n",
        "def preprocess(example):\n",
        "    text = f\"Question: {example['question']}\\nAnswer: {example['answer']}\"\n",
        "    return {\"text\": text}\n",
        "\n",
        "dataset = dataset.map(preprocess)\n",
        "\n",
        "7. Tokenization\n",
